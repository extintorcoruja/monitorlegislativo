function importarBaseInicial() {
  prepararBancoV42();
  var atuais = getRows_(getDb_(),'PROPOSITURAS');
  var seen = {};
  atuais.forEach(function(p){
    seen[chaveProp_(p)] = true;
  });
  var adicionadas = 0;
  BASE_INICIAL.forEach(function(p){
    var k = chaveProp_(p);
    if (seen[k]) return;
    appendObject_('PROPOSITURAS', p);
    seen[k] = true;
    adicionadas++;
  });
  return 'Importação concluída: ' + adicionadas + ' adicionada(s). Base inicial: ' + BASE_INICIAL.length + '.';
}
